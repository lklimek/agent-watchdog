WATCHDOG_UID=1000
WATCHDOG_GID=1000

WATCHDOG_BASIC_USERNAME=operator
WATCHDOG_BASIC_PASSWORD=replace-with-a-long-random-password
WATCHDOG_BEARER_TOKEN=replace-with-a-different-long-random-token
WATCHDOG_GITHUB_TOKEN=
WATCHDOG_HOME_ASSISTANT_WEBHOOK=
WATCHDOG_WEBHOOK=

WATCHDOG_HTTP_BIND_ADDRESS=127.0.0.1
WATCHDOG_HTTP_PORT=8080
# Docker's default Linux bridge range; replace or extend with the exact LAN/VPN CIDR.
WATCHDOG_TRUSTED_CIDRS=172.16.0.0/12
WATCHDOG_TRAEFIK_USERS_FILE=./config/traefik-users
WATCHDOG_CONFIG_FILE=./config/watchdog.toml

WATCHDOG_CLAUDE_PROJECTS_PATH=/home/example/.claude/projects
WATCHDOG_CLAUDE_TEAMS_PATH=/home/example/.claude/teams
WATCHDOG_CLAUDE_TASKS_PATH=/home/example/.claude/tasks
WATCHDOG_CLAUDE_SESSIONS_PATH=/home/example/.claude/sessions
WATCHDOG_CODEX_STATE_DB_PATH=/home/example/.codex/state_5.sqlite
WATCHDOG_CODEX_SESSIONS_PATH=/home/example/.codex/sessions
WATCHDOG_COMPANION_STATE_PATH=/home/example/.claude/plugins/data/codex-openai-codex/state
WATCHDOG_WORKTREE_ROOT_PATH=/home/example/git
WATCHDOG_AGENT_WORKTREE_ROOT_PATH=/data/git-worktrees

RUST_LOG=watchdog_server=info,watchdog_runtime=info,watchdog_store=info
WATCHDOG_IMAGE_TAG=local
WATCHDOG_VERSION=0.1.0
WATCHDOG_VCS_REF=unknown
WATCHDOG_BUILD_DATE=unknown
